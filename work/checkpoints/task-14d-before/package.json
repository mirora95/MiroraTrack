{
  "name": "miroratrack",
  "private": true,
  "version": "0.1.0",
  "description": "A private, local-first personal finance desktop application.",
  "repository": "https://github.com/mirora95/MiroraTrack.git",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "desktop:check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:build:x64": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --ci",
    "desktop:build:arm64": "tauri build --target aarch64-pc-windows-msvc --bundles nsis --ci",
    "tauri": "tauri"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tauri-apps/api": "^2.8.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.1",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.16"
  }
}
