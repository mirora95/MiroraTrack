import { useCallback, useEffect, useState, type ReactNode } from 'react'
import { HashRouter, Navigate, Route, Routes, useLocation } from 'react-router-dom'
import { ArrowUpRight, ShieldCheck, Sparkles } from 'lucide-react'
import { AppShell } from './AppShell'
import {
  RuntimeProvider,
  type AppRuntime,
} from './runtime'
import {
  createProductionRuntime,
  type RuntimeBootResult,
} from './productionRuntime'
import type { InitializationState } from '../application/initializationService'
import { Button } from '../components/Button'
import { Card } from '../components/Card'
import { EmptyState } from '../components/EmptyState'
import { AccountsPage } from '../features/accounts/AccountsPage'
import { OnboardingPage } from '../features/onboarding/OnboardingPage'
import { TransactionsPage } from '../features/transactions/TransactionsPage'
import { ActivityPage } from '../features/activity/ActivityPage'
import { DashboardPage } from '../features/dashboard/DashboardPage'
import { BudgetsPage } from '../features/budgets/BudgetsPage'

const pages = [
  {
    path: '/',
    title: 'Dashboard',
    eyebrow: 'Your financial command center',
    description: 'A clear view of everything you own, spend, and save.',
  },
  {
    path: '/transactions',
    title: 'Transactions',
    eyebrow: 'Money in motion',
    description: 'Track income, expenses, and transfers in one private ledger.',
  },
  {
    path: '/budgets',
    title: 'Budgets',
    eyebrow: 'Spend with intention',
    description: 'Build flexible monthly plans that make progress feel tangible.',
  },
  {
    path: '/activity',
    title: 'Activity',
    eyebrow: 'A transparent record',
    description: 'Review important changes made across your private workspace.',
  },
  {
    path: '/settings',
    title: 'Settings',
    eyebrow: 'Make MiroraTrack yours',
    description: 'Choose how your local desktop experience looks and behaves.',
  },
] as const

function RoutePlaceholder({
  title,
  eyebrow,
  description,
}: (typeof pages)[number]) {
  return (
    <div className="placeholder-page">
      <section className="page-hero">
        <div>
          <p className="eyebrow">{eyebrow}</p>
          <h1 id="page-title">{title}</h1>
          <p className="page-hero__description">{description}</p>
        </div>
        <div className="page-hero__trust">
          <ShieldCheck size={18} aria-hidden="true" />
          <span>Offline and private by design</span>
        </div>
      </section>
      <div className="placeholder-grid" aria-label={`${title} preview`}>
        <Card className="placeholder-card placeholder-card--featured">
          <span className="placeholder-card__icon">
            <Sparkles size={20} aria-hidden="true" />
          </span>
          <p className="eyebrow">Coming next</p>
          <h2>Your private financial workspace is taking shape.</h2>
          <p>
            The complete {title.toLowerCase()} workflow will arrive in the next
            focused build step, ready for your local data.
          </p>
          <Button variant="secondary" icon={<ArrowUpRight size={18} aria-hidden="true" />}>
            Explore the workspace
          </Button>
        </Card>
        <Card className="placeholder-card placeholder-card--empty">
          <EmptyState
            title={`No ${title.toLowerCase()} yet`}
            description="Your information will appear here once you add it. Nothing leaves this computer."
            action={<Button variant="ghost">Learn how it works</Button>}
          />
        </Card>
      </div>
    </div>
  )
}

export function AppRouter({ runtime }: { runtime: AppRuntime }) {
  return (
    <HashRouter>
      <RuntimeProvider runtime={runtime}>
        <InitializationGate runtime={runtime} />
      </RuntimeProvider>
    </HashRouter>
  )
}

function InitializationGate({ runtime }: { runtime: AppRuntime }) {
  const location = useLocation()
  const [state, setState] = useState<InitializationState | 'loading' | 'failed'>('loading')
  const [attempt, setAttempt] = useState(0)

  useEffect(() => {
    let active = true
    setState('loading')
    void runtime.initialization.getState().then(
      (next) => { if (active) setState(next) },
      () => { if (active) setState('failed') },
    )
    return () => { active = false }
  }, [attempt, runtime])

  if (state === 'loading') return <StartupLoading />
  if (state === 'failed') {
    return (
      <RecoveryPage
        reason="MiroraTrack could not read the local workspace."
        action={<Button onClick={() => setAttempt((value) => value + 1)}>Try again</Button>}
      />
    )
  }
  if (state.status === 'recovery-required') {
    return <RecoveryPage reason="The local records are incomplete or incompatible. MiroraTrack stopped before making changes." />
  }
  if (state.status === 'uninitialized' && location.pathname !== '/onboarding') {
    return <Navigate to="/onboarding" replace />
  }
  if (state.status === 'ready' && location.pathname === '/onboarding') {
    return <Navigate to="/" replace />
  }

  return (
    <Routes>
      <Route
        path="/onboarding"
        element={
          <OnboardingPage
            service={runtime.initialization}
            onInitialized={() => setState({ status: 'ready' })}
          />
        }
      />
      <Route element={<AppShell />}>
        {pages.filter(({ path }) => !['/', '/transactions', '/budgets', '/activity'].includes(path)).map((page) => (
          <Route
            key={page.path}
            index={page.path === '/'}
            path={page.path === '/' ? undefined : page.path}
            element={<RoutePlaceholder {...page} />}
          />
        ))}
        <Route
          path="/accounts"
          element={<AccountsPage service={runtime.accounts} />}
        />
        <Route index element={<DashboardPage service={runtime.dashboard} />} />
        <Route path="/budgets" element={<BudgetsPage service={runtime.budgets} />} />
        <Route path="/transactions" element={<TransactionsPage service={runtime.transactions} accounts={runtime.accounts} />} />
        <Route path="/activity" element={<ActivityPage service={runtime.activity} />} />
        <Route path="*" element={<Navigate to="/" replace />} />
      </Route>
    </Routes>
  )
}

function StartupLoading() {
  return (
    <main className="startup-state" role="status" aria-label="Preparing your private workspace">
      <div className="startup-state__mark"><Sparkles aria-hidden="true" /></div>
      <h1>MiroraTrack</h1>
      <p>Preparing your private workspace</p>
    </main>
  )
}

function RecoveryPage({ reason, action }: { reason: string; action?: ReactNode }) {
  return (
    <main className="recovery-page">
      <div className="recovery-page__panel">
        <div className="recovery-page__icon"><ShieldCheck aria-hidden="true" /></div>
        <p className="eyebrow">Read-only protection</p>
        <h1>Your data needs attention</h1>
        <p>{reason}</p>
        <p>No finance data was deleted or overwritten.</p>
        {action}
      </div>
    </main>
  )
}

function App() {
  const [boot, setBoot] = useState<RuntimeBootResult | 'loading' | 'failed'>('loading')
  const load = useCallback(() => {
    setBoot('loading')
    void createProductionRuntime().then(setBoot, () => setBoot('failed'))
  }, [])

  useEffect(load, [load])

  if (boot === 'loading') return <StartupLoading />
  if (boot === 'failed') {
    return <RecoveryPage reason="MiroraTrack could not open its local database." action={<Button onClick={load}>Try again</Button>} />
  }
  if (boot.status === 'recovery-required') {
    return <RecoveryPage reason={`The local database requires recovery (${boot.reason}).`} />
  }
  return <AppRouter runtime={boot.runtime} />
}

export default App
